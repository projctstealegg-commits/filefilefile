-- ============================================================
-- FARM • AUTO BARBLE
-- Selects hotbar slot 1 and automatically hits OsuTrain circles.
-- Uses the game's normal OsuTrain remote; no metamethod hooks.
-- ============================================================

local AutoBarbleEnabled = false
local AutoBarbleRoundActive = false
local AutoBarblePending = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RequestSelectHotbar = Remotes:WaitForChild("RequestSelectHotbar")
local OsuTrain = Remotes:WaitForChild("OsuTrain")

local OsuTrainConfig
pcall(function()
    OsuTrainConfig = require(ReplicatedStorage:WaitForChild("OsuTrainConfig"))
end)

local function selectFirstHotbar()
    pcall(function()
        RequestSelectHotbar:FireServer(1)
    end)
end

local function clearAutoBarblePending()
    table.clear(AutoBarblePending)
end

OsuTrain.OnClientEvent:Connect(function(data)
    if not AutoBarbleEnabled or type(data) ~= "table" then
        return
    end

    if data.kind == "start" then
        AutoBarbleRoundActive = true
        clearAutoBarblePending()
        return
    elseif data.kind == "stop" or data.kind == "miss" then
        if data.kind == "stop" then
            AutoBarbleRoundActive = false
            clearAutoBarblePending()
        end
        return
    end

    if data.kind ~= "spawn" or not AutoBarbleRoundActive then
        return
    end

    local circleId = tonumber(data.id)
    if not circleId or AutoBarblePending[circleId] then
        return
    end

    AutoBarblePending[circleId] = true

    -- Wait until the approach ring reaches the hit circle.
    local life = math.max(0.2, tonumber(data.life) or 1)
    local approachAt = 0.7
    if OsuTrainConfig and tonumber(OsuTrainConfig.APPROACH_AT) then
        approachAt = tonumber(OsuTrainConfig.APPROACH_AT)
    end
    local hitDelay = math.clamp(life * approachAt, 0.03, life)

    task.delay(hitDelay, function()
        AutoBarblePending[circleId] = nil

        if not AutoBarbleEnabled or not AutoBarbleRoundActive then
            return
        end

        pcall(function()
            OsuTrain:FireServer({
                id = circleId,
                kind = "hit"
            })
        end)
    end)
end)

FarmTab:Separator({
    Text = "Auto Barble"
})

FarmTab:Checkbox({
    Label = "Enable Auto Barble",
    Value = false,
    Callback = function(_, enabled)
        AutoBarbleEnabled = enabled == true
        clearAutoBarblePending()

        if AutoBarbleEnabled then
            AutoBarbleRoundActive = true
            selectFirstHotbar()
        else
            AutoBarbleRoundActive = false
        end
    end
})

FarmTab:Label({
    Text = "Auto-selects hotbar 1 and hits spawned OsuTrain circles."
})



-- ============================================================
-- FARM • AUTO FARMING JUMP
-- Uses the KickController public client bridge (_G.KickAuto).
-- The game remains responsible for flight, landing and rewards.
-- ============================================================

local AutoFarmingJumpEnabled = false
local AutoFarmingJumpWorker = false

local AUTO_JUMP_ZONE = CFrame.new(
    208.719727, 20.5545425, 104.067871,
    1, 0, 0,
    0, 1, 0,
    0, 0, 1
)

local RunService = game:GetService("RunService")

local function getKickAutoController()
    local controller = _G.KickAuto
    if type(controller) ~= "table"
        or type(controller.press) ~= "function"
        or type(controller.lock) ~= "function"
        or type(controller.state) ~= "function" then
        return nil
    end
    return controller
end

local function readKickState(controller)
    local ok, state = pcall(controller.state)
    if ok and type(state) == "table" then
        return state
    end
    return nil
end

local function getLocalCharacter()
    local character = LP.Character
    if not character then
        return nil, nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or humanoid.Health <= 0 or not root then
        return nil, nil, nil
    end

    return character, humanoid, root
end

local function moveIntoJumpZone()
    local character = getLocalCharacter()
    if not character then
        return false
    end

    -- Instant character reposition as requested.
    local ok = pcall(function()
        character:PivotTo(AUTO_JUMP_ZONE)
    end)

    return ok
end

local function waitForZone(controller, timeout)
    local deadline = os.clock() + timeout

    repeat
        if not AutoFarmingJumpEnabled then
            return false
        end

        local state = readKickState(controller)
        if state and state.inZone == true then
            return true
        end

        task.wait(0.1)
    until os.clock() >= deadline

    return false
end

local function waitForMinigame(controller, timeout)
    local deadline = os.clock() + timeout

    repeat
        if not AutoFarmingJumpEnabled then
            return false
        end

        local state = readKickState(controller)
        if state and state.minigameActive == true then
            return true
        end

        task.wait(0.03)
    until os.clock() >= deadline

    return false
end

local function lockPerfectTiming(controller, timeout)
    local playerGui = LP:FindFirstChildOfClass("PlayerGui")
    local minigame = playerGui and playerGui:FindFirstChild("KickMinigame")
    local bar = minigame and minigame:FindFirstChild("Bar")
    local movingBar = bar and bar:FindFirstChild("MovingBar")

    if not movingBar then
        return false
    end

    local deadline = os.clock() + timeout

    -- KickController uses MovingBar.Size.Y.Scale as its fill fraction.
    -- 0.92 and above maps to the game's Perfect tier.
    while AutoFarmingJumpEnabled and os.clock() < deadline do
        local state = readKickState(controller)

        if not state or state.minigameActive ~= true then
            return false
        end

        if movingBar.Parent and movingBar.Size.Y.Scale >= 0.92 then
            local ok, result = pcall(controller.lock)
            return ok and result ~= false
        end

        RunService.RenderStepped:Wait()
    end

    return false
end

local function waitForKickToFinish(controller, timeout)
    local deadline = os.clock() + timeout
    local sawKickInProgress = false

    while AutoFarmingJumpEnabled and os.clock() < deadline do
        local state = readKickState(controller)

        if state then
            if state.kickInProgress == true then
                sawKickInProgress = true
            elseif sawKickInProgress then
                -- KickController clears this on landed/abort.
                return true
            end
        end

        task.wait(0.2)
    end

    return false
end

local function runAutoFarmingJump()
    local controller = getKickAutoController()

    if not controller then
        warn("[VIP DELS HUB] KickController is not ready. Enable Auto Farm Jump after the game loads.")
        return
    end

    while AutoFarmingJumpEnabled do
        local character = getLocalCharacter()

        if not character then
            task.wait(0.5)
            continue
        end

        local state = readKickState(controller)

        -- Never teleport while a jump/flight is already active.
        if state and state.kickInProgress == true then
            waitForKickToFinish(controller, 150)
            task.wait(0.5)
            continue
        end

        -- Enter the configured zone and wait for the game's own zone flag.
        if not (state and state.inZone == true) then
            if not moveIntoJumpZone() then
                task.wait(0.5)
                continue
            end

            if not waitForZone(controller, 5) then
                task.wait(0.5)
                continue
            end
        end

        state = readKickState(controller)
        if not state or state.minigameActive == true
            or state.kickInProgress == true then
            task.wait(0.25)
            continue
        end

        -- Start the normal in-game charge/minigame through KickController.
        local pressOK, pressed = pcall(controller.press)
        if not pressOK or pressed ~= true then
            task.wait(0.5)
            continue
        end

        if not waitForMinigame(controller, 5) then
            task.wait(0.5)
            continue
        end

        -- Lock the timing bar at the Perfect threshold.
        if not lockPerfectTiming(controller, 12) then
            -- Do not forge a tier or send a direct reward/launch request.
            -- Let the controller recover, then safely retry.
            task.wait(1)
            continue
        end

        -- Wait for the controller to acknowledge the kick and complete flight.
        -- The server handles landing, reward collection and return flow.
        waitForKickToFinish(controller, 150)

        if AutoFarmingJumpEnabled then
            task.wait(0.75)
        end
    end
end

FarmTab:Separator({
    Text = "Auto Farming Jump"
})

FarmTab:Checkbox({
    Label = "Enable Auto Farming Jump",
    Value = false,
    Callback = function(_, enabled)
        AutoFarmingJumpEnabled = enabled == true

        if AutoFarmingJumpEnabled and not AutoFarmingJumpWorker then
            AutoFarmingJumpWorker = true

            task.spawn(function()
                local ok, err = pcall(runAutoFarmingJump)

                if not ok then
                    warn("[VIP DELS HUB] Auto Farming Jump error: " .. tostring(err))
                end

                AutoFarmingJumpWorker = false
            end)
        end
    end
})

FarmTab:Label({
    Text = "Auto enters Jump Zone, starts the jump, locks Perfect, and waits for landing."
})


