    logo.Name = "Logo"
    logo.BackgroundTransparency = 1
    logo.Size = UDim2.new(1, -2, 1, -2)
    logo.Position = UDim2.fromOffset(1, 1)
    logo.ScaleType = Enum.ScaleType.Fit
    logo.Image = ""
    logo.ZIndex = 21
